# Database Configuration
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://postgres:password@localhost:5432/blog_api?schema=public"

# Authentication & Security
# Use a strong, random secret key in production (generate with: openssl rand -base64 32)
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="900" # seconds
REFRESH_SECRET="another-long-random-secret"
REFRESH_MS="604800000" # milliseconds

# Bcrypt salt rounds (10-12 recommended, higher = more secure but slower)
BCRYPT_ROUNDS=10

# Server Configuration
PORT=3000
NODE_ENV=development

# Logging Configuration
# Levels: error, warn, info, http, verbose, debug, silly
LOG_LEVEL=debug

# CORS Configuration (comma-separated origins)
# In development: http://localhost:3000,http://localhost:5173
# In production: https://yourdomain.com
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"

# Rate Limiting (optional)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
